# ==============================================================================
# CatchThePrice (catchtheprice.com) — Environment Variable Template
# ==============================================================================
# VARIABLE NAMES ONLY. Populate values in .env.local or your hosting environment.
# See docs/SETUP.md for full instructions on where to obtain each value.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
CRON_SECRET=
ENABLE_DEMO_CATALOG=
NEXT_PUBLIC_DEFAULT_COUNTRY=
BESTBUY_API_KEY=
# Server-only affiliate/feed credentials. Never prefix these with NEXT_PUBLIC_.
AMAZON_ASSOCIATES_ACCESS_KEY=
AMAZON_ASSOCIATES_SECRET_KEY=
AMAZON_ASSOCIATES_PARTNER_TAG=
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
# Optional override; otherwise the active CatchThePrice ad space is discovered via the API.
ADMITAD_AD_SPACE_ID=
# Optional approved feed override; never use a scraped catalog URL.
ADMITAD_PRODUCT_FEED_URL=
# One secure XML export URL per approved source. These are server-only and must
# never be added as NEXT_PUBLIC variables or committed with real values.
ADMITAD_FEED_MAX_ITEMS_PER_RUN=1000
ADMITAD_FEED_ALIEXPRESS_UNDER_10_URL=
ADMITAD_FEED_ALIEXPRESS_10_25_URL=
ADMITAD_FEED_ALIEXPRESS_25_40_URL=
ADMITAD_FEED_ALIEXPRESS_40_55_URL=
ADMITAD_FEED_ALIEXPRESS_55_70_URL=
ADMITAD_FEED_ALIEXPRESS_70_85_URL=
ADMITAD_FEED_ALIEXPRESS_85_100_URL=
ADMITAD_FEED_ALIEXPRESS_OVER_100_URL=
ADMITAD_FEED_ALIEXPRESS_HOT_PRODUCTS_URL=
ADMITAD_FEED_CANON_UAE_CAMERA_URL=
ADMITAD_FEED_GEEKBUYING_WW_MAIN_2_URL=
ADMITAD_FEED_GLASSESLIT_WW_MAIN_2_URL=
ADMITAD_FEED_JUMBO_AE_MAIN_URL=
ADMITAD_FEED_LUXURY_CLOSET_AED_URL=
