# ==============================================================================
# CatchThePrice (catchtheprice.com) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or populate in Vercel project settings.

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://catchtheprice.com

# Supabase Configuration
# Dedicated CatchThePrice Project ID: jghpyvawgdfhfqmtiexb
NEXT_PUBLIC_SUPABASE_URL=https://jghpyvawgdfhfqmtiexb.supabase.co
# Prefer the modern publishable key. ANON_KEY remains supported for older Supabase setups.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Private server-only secret. Never expose this in NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Private admin access. Comma-separate multiple approved administrator emails.
# If empty, nobody can enter /admin even when authenticated.
ADMIN_EMAILS=admin@catchtheprice.com

# Server-only secret used to authenticate scheduled /api/cron/* jobs.
# Generate a long random value and store it only in the hosting environment.
CRON_SECRET=replace_with_a_long_random_secret

# Preview catalog fixtures. Keep FALSE on the real catchtheprice.com production deployment.
ENABLE_DEMO_CATALOG=false

# Default Launch Market (ae, us)
NEXT_PUBLIC_DEFAULT_COUNTRY=ae

# Approved retailer/source credentials (server-only)
# Add only after the corresponding source-rights record is reviewed and activated.
BESTBUY_API_KEY=

# Google AdSense (Optional / Production)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_TEST_MODE=true
